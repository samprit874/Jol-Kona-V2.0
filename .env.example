# Copy this file to `.env` for local development and populate the values.
# In production, set the same keys in the Vercel project dashboard
# (Settings → Environment Variables). Never commit a real `.env` file.

# --- Firebase Admin SDK (server-only) ---------------------------------------
# From: Firebase Console → Project Settings → Service accounts → Generate new
# private key. Paste the *raw* PEM value for FIREBASE_PRIVATE_KEY, including
# the BEGIN/END PRIVATE KEY markers. Real newlines are fine; Vercel's UI
# automatically escapes "\n" and the function will normalise them either way.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Resend (server-only) ---------------------------------------------------
# Verify the domain used by RESEND_FROM in Resend before sending production mail.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Jol Kona <noreply@jolkona.dpdns.org>"
# Must be an authorised URL in Firebase Authentication → Settings.
VERIFICATION_REDIRECT_URL=https://jolkona.dpdns.org/account.html

