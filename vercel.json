{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.jolkona.dpdns.org"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "admin.jolkona.dpdns.org"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "has": [
        {
          "type": "host",
          "value": "admin.jolkona.dpdns.org"
        }
      ],
      "destination": "/admin.html"
    }
  ]
}
